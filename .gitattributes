# Normalize text files in the repository and keep source files on LF.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
gradlew text eol=lf

# Windows command scripts require CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never run end-of-line conversion on binary assets.
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
